{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild js/player-bootstrap.js --bundle --format=esm --splitting --outdir=dist",
    "build:cdn": "node scripts/build-cdn-bundle.mjs",
    "build:cdn-shell": "node scripts/build-cdn-shell.mjs",
    "snapshot:cdn": "node scripts/snapshot-cdn-player-data.mjs",
    "watch": "esbuild js/player-bootstrap.js --bundle --format=esm --splitting --outdir=dist --watch",
    "serve": "node scripts/dev-server.mjs",
    "dev": "npm run build && npm run serve",
    "check": "node --check api/*.js && node --check scripts/*.mjs && node --check js/main.js && node --check js/editor.js && node --check js/physics.js && node --check js/destruction-mode.js && node --check js/player-bootstrap.js && node --check js/image-compression.js && node --check js/visual-layout.js && node --check js/character-config.js",
    "migrate:assets": "node scripts/migrate-assets.mjs",
    "mirror:assets": "node scripts/mirror-assets-to-github.mjs",
    "test:assets": "node scripts/asset-store-smoke.mjs",
    "test:destruction": "node scripts/destruction-smoke.mjs",
    "test:hinges": "node scripts/destruction-hinge-smoke.mjs",
    "test:des-generator": "node scripts/destruction-generator-smoke.mjs",
    "generate:des": "node generators/destruction/build-catalog.mjs && node generators/destruction/build-report.mjs",
    "generate:des1": "node generators/destruction1/build-catalog.mjs && node generators/destruction1/build-report.mjs",
    "test:des1": "node scripts/destruction-intents-smoke.mjs",
    "test:player-regression": "node scripts/player-regression-smoke.mjs",
    "test:cdn-shell": "node scripts/cdn-shell-smoke.mjs",
    "generate:des2": "node generators/destruction2/build-catalog.mjs && node generators/destruction2/robustness.mjs && node generators/destruction2/build-report.mjs",
    "test:des2": "node scripts/des2-smoke.mjs"
  },
  "dependencies": {
    "ioredis": "^5.10.0",
    "ios-haptics": "^0.1.4"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
