{
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/player/**"
    }
  },
  "rewrites": [
    {
      "source": "/:room(\\d{4})",
      "has": [{ "type": "host", "value": "al3a.vercel.app" }],
      "destination": "/player.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "al3a.vercel.app" }],
      "destination": "/player.html"
    },
    {
      "source": "/",
      "destination": "/editor.html"
    }
  ]
}
