{
  "buildCommand": "npx esbuild js/player-bootstrap.js --bundle --format=esm --splitting --outdir=dist",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/player/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "al3a.vercel.app" }],
      "destination": "/player.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "alea.sh" }],
      "destination": "/player.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.alea.sh" }],
      "destination": "/player.html"
    },
    {
      "source": "/",
      "destination": "/editor.html"
    }
  ]
}
