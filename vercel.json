{
  "buildCommand": "node scripts/build-cdn-shell.mjs",
  "outputDirectory": "vercel-shell",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/player/**"
    }
  },
  "rewrites": [
    {
      "source": "/gen",
      "destination": "/gen/index.html"
    },
    {
      "source": "/gen/",
      "destination": "/gen/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/player.html",
      "destination": "/index.html"
    }
  ]
}
