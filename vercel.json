{
  "buildCommand": "node scripts/build-cdn-shell.mjs",
  "outputDirectory": "vercel-shell",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/player/**"
    }
  },
  "rewrites": [
    {"source":"/surv","destination":"/surv/index.html"},
    {"source":"/surv/","destination":"/surv/index.html"},
    {"source":"/des6","destination":"/des6/index.html"},
    {"source":"/des6/","destination":"/des6/index.html"},
    {"source":"/des6/report","destination":"/des6/report/index.html"},
    {"source":"/des6/report/","destination":"/des6/report/index.html"},
    {"source":"/des5","destination":"/des5/index.html"},
    {"source":"/des5/","destination":"/des5/index.html"},
    {"source":"/des5/report","destination":"/des5/report/index.html"},
    {"source":"/des5/report/","destination":"/des5/report/index.html"},
    {"source":"/des4","destination":"/des4/index.html"},
    {"source":"/des4/","destination":"/des4/index.html"},
    {"source":"/des4/report","destination":"/des4/report/index.html"},
    {"source":"/des4/report/","destination":"/des4/report/index.html"},
    {
      "source": "/des3",
      "destination": "/des3/index.html"
    },
    {
      "source": "/des3/",
      "destination": "/des3/index.html"
    },
    {
      "source": "/des3/report",
      "destination": "/des3/report/index.html"
    },
    {
      "source": "/des3/report/",
      "destination": "/des3/report/index.html"
    },
    {
      "source": "/des2",
      "destination": "/des2/index.html"
    },
    {
      "source": "/des2/",
      "destination": "/des2/index.html"
    },
    {
      "source": "/des2/report",
      "destination": "/des2/report/index.html"
    },
    {
      "source": "/des2/report/",
      "destination": "/des2/report/index.html"
    },
    {
      "source": "/des1",
      "destination": "/des1/index.html"
    },
    {
      "source": "/des1/",
      "destination": "/des1/index.html"
    },
    {
      "source": "/des1/report",
      "destination": "/des1/report/index.html"
    },
    {
      "source": "/des1/report/",
      "destination": "/des1/report/index.html"
    },
    {
      "source": "/editor",
      "destination": "/editor.html"
    },
    {
      "source": "/:room(\\d{4})",
      "destination": "/index.html"
    },
    {
      "source": "/des",
      "destination": "/des/index.html"
    },
    {
      "source": "/des/",
      "destination": "/des/index.html"
    },
    {
      "source": "/des/editor",
      "destination": "/des/editor/index.html"
    },
    {
      "source": "/des/editor/",
      "destination": "/des/editor/index.html"
    },
    {
      "source": "/des/report",
      "destination": "/des/report/index.html"
    },
    {
      "source": "/des/report/",
      "destination": "/des/report/index.html"
    },
    {
      "source": "/gen",
      "destination": "/gen/index.html"
    },
    {
      "source": "/gen/",
      "destination": "/gen/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/player.html",
      "destination": "/index.html"
    }
  ]
}
